# Environment Variables Template for Airbyte on GKE
# Copy this file to .env and update with your values

# ================================
# GCP Configuration
# ================================
PROJECT_ID=your-gcp-project-id
CLUSTER_NAME=airbyte-cluster
ZONE=us-central1-a
REGION=us-central1

# ================================
# GKE Cluster Configuration
# ================================
MACHINE_TYPE=n1-standard-4
NUM_NODES=3
MIN_NODES=3
MAX_NODES=10

# ================================
# Kubernetes Configuration
# ================================
NAMESPACE=airbyte
KSA_NAME=airbyte-sa
GSA_NAME=airbyte-gsa

# ================================
# Airbyte Version
# ================================
AIRBYTE_VERSION=2.0.1

# ================================
# Database Configuration
# ================================
# For internal PostgreSQL
DATABASE_USER=airbyte
DATABASE_PASSWORD=change-me-in-production
DATABASE_DB=airbyte
DATABASE_PORT=5432

# For external database (Cloud SQL)
# DATABASE_HOST=10.x.x.x  # Cloud SQL private IP
# DATABASE_HOST=airbyte-db-svc  # Internal PostgreSQL

# ================================
# Minio Configuration
# ================================
MINIO_ACCESS_KEY=minio-admin
MINIO_SECRET_KEY=change-me-in-production
MINIO_ENDPOINT=http://airbyte-minio-svc:9000

# ================================
# Basic Authentication (UI)
# ================================
BASIC_AUTH_USERNAME=airbyte
BASIC_AUTH_PASSWORD=change-me-in-production

# ================================
# Airbyte API
# ================================
# Generate token from: Settings → Account → Applications
AIRBYTE_API_TOKEN=your-api-token-here
AIRBYTE_API_HOST=http://localhost:8001

# ================================
# Backup Configuration
# ================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ================================
# Worker Configuration
# ================================
MAX_SYNC_WORKERS=5
MAX_SPEC_WORKERS=5
MAX_CHECK_WORKERS=5
SYNC_JOB_MAX_ATTEMPTS=3
SYNC_JOB_MAX_TIMEOUT_DAYS=3

# ================================
# Storage Configuration
# ================================
# For GCS (Google Cloud Storage)
# STATE_STORAGE_GCS_BUCKET_NAME=your-bucket-name
# STATE_STORAGE_GCS_APPLICATION_CREDENTIALS=/secrets/gcs-credentials.json

# For internal Minio
STATE_STORAGE_MINIO_ENDPOINT=http://airbyte-minio-svc:9000
STATE_STORAGE_MINIO_ACCESS_KEY=minio-admin
STATE_STORAGE_MINIO_SECRET_KEY=change-me-in-production

# ================================
# Logging Configuration
# ================================
LOG_LEVEL=INFO

# ================================
# Tracking and Analytics
# ================================
TRACKING_STRATEGY=anonymous
# Set to "disabled" to completely disable tracking

# ================================
# Resource Limits (Namespace)
# ================================
RESOURCE_QUOTA_CPU_REQUESTS=10
RESOURCE_QUOTA_CPU_LIMITS=20
RESOURCE_QUOTA_MEMORY_REQUESTS=20Gi
RESOURCE_QUOTA_MEMORY_LIMITS=40Gi
RESOURCE_QUOTA_PODS=50
RESOURCE_QUOTA_PVC=10
RESOURCE_QUOTA_STORAGE=500Gi

# ================================
# Notes
# ================================
# 1. DO NOT commit .env file to version control
# 2. Update all "change-me-in-production" values
# 3. Generate strong passwords for production
# 4. Use Cloud SQL for production databases
# 5. Use GCS for production storage
# 6. Rotate credentials regularly
